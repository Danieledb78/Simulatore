# Database
DATABASE_URL="postgresql://user:password@localhost:5432/beverage_warehouse?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# WhatsApp Business API (Meta)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Beverage Warehouse <noreply@example.com>"

# Frontend URLs
WEB_APP_URL=http://localhost:5173
MOBILE_APP_SCHEME=beverageapp

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Redis (for caching/sessions)
REDIS_URL=redis://localhost:6379

# Fatturazione Elettronica (opzionale)
SDI_ENDPOINT=https://api.fatturapa.gov.it
SDI_USER=your_sdi_user
SDI_PASSWORD=your_sdi_password
